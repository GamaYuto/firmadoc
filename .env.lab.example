# Copy to .env.lab on the LAB host and replace every placeholder before starting.
# Do not commit .env.lab. Use URL-safe random values for passwords used in DATABASE_URL.
# Pass it to Compose with: docker compose --env-file .env.lab -f compose.lab.yml ...

POSTGRES_DB=firmadoc_lab
POSTGRES_USER=firmadoc_app
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://firmadoc_app:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@firmadoc-db:5432/firmadoc_lab

PROJECT_NAME=FirmaDoc
ALFRESCO_BASE_URL=https://alfresco-lab.test
ALFRESCO_API_PATH=/alfresco/api/-default-/public/alfresco/versions/1
ALFRESCO_USER=firma_service
ALFRESCO_PASSWORD=REPLACE_WITH_MINIMUM_PRIVILEGE_TECHNICAL_ACCOUNT_PASSWORD
ALFRESCO_VERIFY_SSL=true
ALFRESCO_CA_BUNDLE=/etc/firmadoc/certs/clinica-caribe-lab-ca.crt
FIRMADOC_ALFRESCO_EXPECTED_HOST=alfresco-lab.test
FIRMADOC_ALFRESCO_WRITE_ENABLED=false

# Exact enabled Alfresco account assigned to approve management requests.
FIRMADOC_GERENCIA_USER_ID=lblanco
FIRMADOC_GERENCIA_CARGO=Gerencia
FIRMADOC_GERENCIA_TOKEN_EXPIRE_MINUTES=1440

FIRMADOC_LAB_IDENTITY_ENABLED=false
FIRMADOC_SSO_ENABLED=true
FIRMADOC_SSO_ISSUER=alfresco-share
FIRMADOC_SSO_AUDIENCE=firmadoc
FIRMADOC_SSO_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
FIRMADOC_SSO_MAX_AGE_SECONDS=60
FIRMADOC_SSO_CLOCK_SKEW_SECONDS=60
FIRMADOC_ALLOWED_RETURN_ORIGINS=https://alfresco-lab.test

SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
FIRMADOC_SESSION_COOKIE_SECURE=true
FIRMADOC_TMP_DIR=/tmp/firmadoc
