POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=firmadoc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5432/firmadoc
PROJECT_NAME="FirmaDoc API"

ALFRESCO_BASE_URL=http://localhost:8080
ALFRESCO_API_URL=/alfresco/api/-default-/public/alfresco/versions/1
ALFRESCO_USER=firma_service
ALFRESCO_PASSWORD=your_secure_password
ALFRESCO_TIMEOUT_SECONDS=30
ALFRESCO_VERIFY_SSL=False
ALFRESCO_MAX_DOWNLOAD_MB=20
ALFRESCO_API_PATH=/alfresco/api/-default-/public/alfresco/versions/1
ALFRESCO_USERNAME=
ALFRESCO_CA_BUNDLE=
ALFRESCO_CONNECT_TIMEOUT=5
ALFRESCO_READ_TIMEOUT=30
ALFRESCO_WRITE_TIMEOUT=60
ALFRESCO_MAX_DOWNLOAD_SIZE=52428800
ALFRESCO_MAX_HISTORY_PAGES=100
ALFRESCO_HISTORY_PAGE_SIZE=100
FIRMADOC_ALFRESCO_EXPECTED_HOST=alfresco-lab.test
FIRMADOC_ALFRESCO_WRITE_ENABLED=false
FIRMADOC_LAB_IDENTITY_ENABLED=true
FIRMADOC_ALFRESCO_TEST_NODE_ID=
FIRMADOC_ALFRESCO_TEST_EXPECTED_NAME=
FIRMADOC_ALFRESCO_TEST_EXPECTED_PATH=
FIRMADOC_ALFRESCO_TEST_EXPECTED_MIMETYPE=application/pdf
FIRMADOC_ALFRESCO_MAJOR_VERSION=false
FIRMADOC_RECONCILE_MIN_CHECKS=3
FIRMADOC_RECONCILE_WAIT_SECONDS=30

# Clave secreta para cookies de sesion HMAC. Obligatoria (>=32 caracteres) fuera de laboratorio.
# SECRET_KEY=genera_una_clave_aleatoria_de_al_menos_32_caracteres_en_produccion
FIRMADOC_SESSION_COOKIE_NAME=firmadoc_session
FIRMADOC_SESSION_EXPIRE_MINUTES=480
FIRMADOC_SESSION_COOKIE_SECURE=false
