<?xml version="1.0" encoding="UTF-8"?>
<alfresco-config>

    <config evaluator="string-compare" condition="DocLibActions">
        <actions>

            <action
                id="document-sign-firmadoc"
                type="link"
                label="Firmar documento (FirmaDoc)">

                <param name="href">/share/page/firmadoc/sso-start?nodeId={node.nodeRef}&amp;returnUrl=https://alfresco-lab.test/share/page/document-details?nodeRef={node.nodeRef}</param>

                <param name="target">_self</param>

                <permissions>
                    <permission allow="true">Write</permission>
                </permissions>

            </action>

        </actions>

        <actionGroups>

            <actionGroup id="document-browse">
                <action index="400" id="document-sign-firmadoc" />
            </actionGroup>

            <actionGroup id="document-details">
                <action index="400" id="document-sign-firmadoc" />
            </actionGroup>

        </actionGroups>

    </config>

</alfresco-config>